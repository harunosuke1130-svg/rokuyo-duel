rules_version = '2';
// 六耀の決闘 — Cloud Firestore セキュリティルール
// Firebase コンソール →「Firestore Database」→「ルール」に貼り付けて公開してください。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // プロフィール：本人だけが読み書きできる
    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.stones is int && request.resource.data.stones >= 0;
      allow delete: if false;
    }

    // 対戦ルーム：ログインしていれば読める（コードを知っている人が参加するため）
    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.guestUid == null
        && request.resource.data.code == code;
      allow update: if signedIn() && (
        // ホスト：戦闘状態の書き込み（参加者は変えられない）
        (resource.data.hostUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.guestUid == resource.data.guestUid)
        // 参加：待機中のルームに、自分をゲストとして登録するだけ
        || (resource.data.status == 'waiting' && resource.data.guestUid == null
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.status == 'ready'
          && changed().hasOnly(['guestUid', 'guestName', 'guest', 'status', 'updatedAt', 'guestSeen']))
        // ゲスト：行動の依頼と接続確認だけ
        || (resource.data.guestUid == request.auth.uid
          && changed().hasOnly(['intent', 'updatedAt', 'guestSeen']))
      );
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}
